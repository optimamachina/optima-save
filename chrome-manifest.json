{
  "manifest_version": 3,
  "name": "optima save",
  "version": "1.3.0",
  "description": "right-click a video, pick mp4 or mp3 in the save dialog, done. youtube, tiktok, instagram and most other sites.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "save video as…",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "save the video on this page"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
