{
  "manifest_version": 2,
  "name": "optima save",
  "version": "1.3.0",
  "description": "right-click a video, pick mp4 or mp3 in the save dialog, done. youtube, tiktok, instagram and most other sites.",
  "browser_specific_settings": {
    "gecko": {
      "id": "optima-save@optimamachina.world",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/optimamachina/optima-save/main/updates.json"
    }
  },
  "permissions": [
    "menus",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "save video as…",
    "default_icon": "button.svg",
    "default_area": "navbar"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "save the video on this page"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "96": "icon128.png",
    "128": "icon128.png"
  }
}
